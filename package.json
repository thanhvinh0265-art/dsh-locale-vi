{
  "name": "dsh-locale-vi",
  "version": "0.2.0",
  "description": "Vietnamese language pack for DeepSeek Harness: adds the 'Tiếng Việt' UI language and a dictionary for every client plugin that publishes strings through ctx.locale.",
  "type": "module",
  "license": "MIT",
  "author": "Đặng Thành Vinh",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "locale",
    "i18n",
    "vietnamese",
    "deepseek"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhvinh0265-art/dsh-locale-vi.git"
  },
  "homepage": "https://github.com/thanhvinh0265-art/dsh-locale-vi#readme",
  "bugs": {
    "url": "https://github.com/thanhvinh0265-art/dsh-locale-vi/issues"
  }
}
